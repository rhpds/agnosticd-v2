apiVersion: v1
baseDomain: {{ cluster_dns_zone }}
metadata:
  name: {{ _cluster_name }}
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  platform: {}
  replicas: {{ worker_instance_count | int }}
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  platform: {}
  replicas: {{ control_plane_instance_count | int }}
networking:
  clusterNetwork:
  - cidr: {{ ai_cluster_network_cidr }}
    hostPrefix: 23
  machineNetwork:
  - cidr: {{ ai_network_prefix }}.0/{{ ai_network_prefix_length }}
  networkType: OVNKubernetes
  serviceNetwork:
  - {{ ai_service_network_cidr }}
{% if control_plane_instance_count | int == 1 and worker_instance_count | int == 0 %}
platform:
  none: {}
{% else %}
platform:
  baremetal:
    provisioningNetwork: Disabled
    apiVIPs:
    - {{ ai_network_prefix }}.100
    ingressVIPs:
    - {{ ai_network_prefix }}.101
{% endif %}
publish: External
pullSecret: {{ host_ocp4_agent_installer_pull_secret | to_json | to_json if host_ocp4_agent_installer_pull_secret is mapping else host_ocp4_agent_installer_pull_secret | to_json }}
sshKey: {{ host_ocp4_agent_installer_ssh_public_key | trim | to_json }}
{% if host_ocp4_agent_installer_image_digest_sources | length > 0 %}
imageDigestSources: {{ host_ocp4_agent_installer_image_digest_sources | to_json }}
{% endif %}
